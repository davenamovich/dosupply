# Copy to .env for local development (never commit .env itself).
# On Railway, set these as service variables instead of shipping a file.

# ---------------------------------------------------------------------------
# LLM provider (required for /api/generate)
# Any OpenAI-compatible /chat/completions endpoint. The app appends
# "/chat/completions" unless LLM_BASE_URL already ends with it.
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Web research (optional — /api/research needs at least one of these)
# Exa is tried first; TinyFish is the fallback. Both are server-side only.
# ---------------------------------------------------------------------------
EXA_API_KEY=
TINYFISH_API_KEY=
# Override only if you proxy TinyFish: defaults to https://api.search.tinyfish.ai
TINYFISH_SEARCH_URL=

# ---------------------------------------------------------------------------
# Plunder & Riffle MCP engine (optional)
# ---------------------------------------------------------------------------
PLUNDER_RIFFLE_API_KEY=
# Defaults to https://bot.plunderandriffle.com/api/mcp
PLUNDER_RIFFLE_MCP_URL=

# ---------------------------------------------------------------------------
# Setup panel gate (required to save or clear BYOK keys)
# There is no default: with this unset, the setup panel stays locked.
# ---------------------------------------------------------------------------
ADMIN_PASSCODE=

# ---------------------------------------------------------------------------
# Runtime (set by the platform; defaults are fine locally)
# ---------------------------------------------------------------------------
# PORT=3000

# ---------------------------------------------------------------------------
# DO Supply Sales Agent (/sales-agent) — all optional, all server-side only
# With no Telegram credentials the agent runs in simulated mode: the alert is
# generated and shown on /sales-agent/dashboard but never sent.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Inventory providers, tried in this order before the built-in DEMO DATA:
DOSUPPLY_CATALOG_API_URL=
DOSUPPLY_CATALOG_API_KEY=
INVENTORY_CSV_PATH=
# The dashboard reuses ADMIN_PASSCODE (above). Unset = open in dev, closed in production.

# ---------------------------------------------------------------------------
# Engine brand + hosted-video look (optional)
# Creatives are generated as the "dosupply" brand (#NeedItNow) by default.
# Video tools take no brand key. The host's shirt changes per video ("ASK US ABOUT
# <topic subject>"); set ACCESSORY to force one fixed shirt. The set comes from the
# key owner's saved set unless SCENE is given.
# ---------------------------------------------------------------------------
PLUNDER_RIFFLE_BRAND=
PLUNDER_RIFFLE_VIDEO_SCENE=
PLUNDER_RIFFLE_VIDEO_OUTFIT=
PLUNDER_RIFFLE_VIDEO_ACCESSORY=
